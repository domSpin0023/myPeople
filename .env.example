# These two values connect the APP to its one shared database. They are set once by whoever runs the app,
# never by the people who use it. Copy this file to .env.local for local development (it is ignored by git);
# when deployed, set the same two values as environment variables in your hosting project.
# Find them in the Supabase dashboard under Project Settings > API.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The "anon" / "publishable" key. It is safe in the browser because Row Level Security protects the data.
# NEVER put the "service_role" key here: it bypasses every privacy rule.
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
